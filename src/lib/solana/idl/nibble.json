  "types": [
    {
      "name": "Cookie",
      "docs": [
        "A singleton, recycled across every batch — the whole game is this one",
        "account. `bake` resets it; `nibble`/`glaze`/`pull`/`crank_heat` mutate it",
        "while it's Live."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "baker",
            "type": "pubkey"
          },
          {
            "name": "batch_id",
            "type": "u64"
          },
          {
            "name": "hp",
            "type": "u32"
          },
          {
            "name": "heat",
            "type": "u32"
          },
          {
            "name": "created_slot",
            "type": "u64"
          },
          {
            "name": "last_action_slot",
            "type": "u64"
          },
          {
            "name": "nibble_count",
            "type": "u32"
          },
          {
            "name": "last_nibbler",
            "type": "pubkey"
          },
          {
            "name": "state",
            "type": {
              "defined": {
                "name": "CookieState"
              }
            }
          },
          {
            "name": "bump",
            "type": "u8"
          }
